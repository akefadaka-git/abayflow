{
  "name": "abayflow",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source workflow automation focused on secure document intake and approval",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "email:drain": "npm run build && node dist/scripts/drain-email-outbox.js"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "nodemailer": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.15.5",
    "@types/nodemailer": "^6.4.17"
  }
}
